<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Nuget package versions -->
    <AkkaVersion>1.6.0-beta7</AkkaVersion>
    <!-- Aaron.Akka.Reminders ships separately and can lag the Akka.NET beta it targets. -->
    <AkkaRemindersVersion>1.6.0-beta5</AkkaRemindersVersion>
    <!-- Akka.Persistence.Sql also ships separately; used only by tests, for a real serializing journal. -->
    <AkkaPersistenceSqlVersion>1.6.0-beta5</AkkaPersistenceSqlVersion>
    <XunitVersion>4.0.3</XunitVersion>
    <XunitRunnerVersion>4.0.1</XunitRunnerVersion>
    <TestSdkVersion>18.11.0</TestSdkVersion>
  </PropertyGroup>
  <!-- App dependencies -->
  <ItemGroup>
    <PackageVersion Include="Akka.Cluster.Hosting" Version="$(AkkaVersion)" />
    <PackageVersion Include="Akka.Hosting" Version="$(AkkaVersion)" />
    <PackageVersion Include="Aaron.Akka.Reminders" Version="$(AkkaRemindersVersion)" />
    <PackageVersion Include="Akka.Serialization.V2" Version="$(AkkaVersion)" />
    <PackageVersion Include="FSharp.Core" Version="11.0.101" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>
  <!-- Test dependencies -->
  <ItemGroup>
    <PackageVersion Include="Akka.TestKit.Xunit" Version="$(AkkaVersion)" />
    <PackageVersion Include="Akka.Hosting.TestKit" Version="$(AkkaVersion)" />
    <PackageVersion Include="Akka.Persistence.Sql.Hosting" Version="$(AkkaPersistenceSqlVersion)" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="System.Linq.Async" Version="7.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="$(TestSdkVersion)" />
    <PackageVersion Include="xunit.v3" Version="$(XunitVersion)" />
    <PackageVersion Include="xunit.v3.assert" Version="$(XunitVersion)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="$(XunitRunnerVersion)" />
  </ItemGroup>
  <!-- SourceLink support for all Akka.NET projects -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
  </ItemGroup>
</Project>
