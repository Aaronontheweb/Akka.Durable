<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(NetTestVersion)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Akka.Hosting.TestKit" />
    <PackageReference Include="Akka.Persistence.Sql.Hosting" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Pulled in by linq2db; hide it from compilation so it does not clash with .NET's built-in System.Linq.AsyncEnumerable. -->
    <PackageReference Include="System.Linq.Async" ExcludeAssets="compile" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Akka.Durable.Entities/Akka.Durable.Entities.csproj" />
    <ProjectReference Include="../../src/Akka.Durable.TestKit/Akka.Durable.TestKit.csproj" />
  </ItemGroup>
</Project>
